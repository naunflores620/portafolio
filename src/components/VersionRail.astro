---
interface Props {
  versions: number[];
  caption: string;
}

const { versions, caption } = Astro.props;
---

<figure class="rail">
  <ol class="rail-track" style={`--count: ${versions.length}`}>
    {versions.map((version, index) => (
      <li style={`--i: ${index}`}>
        <span class="visually-hidden">Odoo </span>
        {version}
      </li>
    ))}
  </ol>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .rail {
    margin: 0;
  }

  .rail-track {
    --dot: 0.625rem;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    padding: 0;
    list-style: none;
  }

  /* The line that joins every release; it draws once on load. */
  .rail-track::before {
    content: '';
    position: absolute;
    top: calc(var(--dot) / 2 - 1px);
    left: calc(50% / var(--count));
    right: calc(50% / var(--count));
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    animation: draw 900ms cubic-bezier(0.6, 0, 0.2, 1) both;
  }

  .rail-track li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1rem, 3.2vw, 1.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .rail-track li::before {
    content: '';
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--paper);
    animation: appear 240ms ease-out both;
    animation-delay: calc(var(--i) * 90ms + 120ms);
  }

  figcaption {
    margin-top: 0.875rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes appear {
    from {
      transform: scale(0);
    }
  }
</style>
