---
import Layout from '../layouts/Layout.astro';
import Icon, { type IconName } from './Icon.astro';
import VersionRail from './VersionRail.astro';
import { cv, formatPeriod, t, type Lang } from '../data/cv';
import { cvFiles, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = ui[lang];
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const otherHref = otherLang === 'en' ? '/' : '/es/';
const files = cvFiles[lang];

const contacts: { icon: IconName; label: string; href?: string }[] = [
  ...(t(cv.location, lang) ? [{ icon: 'pin' as const, label: t(cv.location, lang) }] : []),
  ...(cv.email ? [{ icon: 'mail' as const, label: cv.email, href: `mailto:${cv.email}` }] : []),
  ...cv.links.map((link) => ({
    icon: link.label.toLowerCase() as IconName,
    label: link.label,
    href: link.href,
  })),
];

const updated = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-SV', {
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<Layout lang={lang}>
  <a class="skip" href="#main">
    {s.skip}
  </a>

  <div class="page">
    <nav class="toolbar" aria-label={s.contact}>
      <a href={otherHref} hreflang={otherLang} lang={otherLang}>
        {s.switchLang}
      </a>
      <button type="button" class="theme" data-theme-toggle aria-label={s.themeToggle}>
        <Icon name="moon" class="when-light" />
        <Icon name="sun" class="when-dark" />
      </button>
    </nav>

    <header class="masthead">
      <h1>{cv.name}</h1>
      <p class="headline">{t(cv.headline, lang)}</p>
      <p class="profession">{t(cv.profession, lang)}</p>

      <ul class="contacts">
        {contacts.map((item) => (
          <li>
            <Icon name={item.icon} />
            {item.href ? (
              <a href={item.href} rel="me noopener" target="_blank">
                {item.label}
              </a>
            ) : (
              <span>{item.label}</span>
            )}
          </li>
        ))}
      </ul>

      <div class="actions">
        <a class="button" href={files.pdf} download>
          <Icon name="download" />
          {s.downloadPdf}
        </a>
        <a class="secondary" href={files.docx} download>
          <Icon name="file" />
          {s.downloadDocx}
        </a>
      </div>

      <VersionRail versions={cv.odooVersions} caption={s.railCaption} />
    </header>

    <main id="main">
      <section class="row" aria-labelledby="summary">
        <h2 id="summary">{s.summary}</h2>
        <p class="lead">{t(cv.summary, lang)}</p>
      </section>

      <section class="row" aria-labelledby="experience">
        <h2 id="experience">{s.experience}</h2>
        <div class="stack">
          {cv.experience.map((role) => {
            const period = formatPeriod(role.start, role.end, lang);
            return (
              <article class="role">
                {period && <p class="period">{period}</p>}
                <h3>{t(role.title, lang)}</h3>
                <p class="meta">
                  {[role.company, role.location && t(role.location, lang)]
                    .filter(Boolean)
                    .join(', ')}
                </p>
                <p>{t(role.summary, lang)}</p>
                <ul class="bullets">
                  {role.highlights.map((item) => (
                    <li>{t(item, lang)}</li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>
      </section>

      <section class="row" aria-labelledby="expertise">
        <h2 id="expertise">{s.expertise}</h2>
        <dl class="ledger">
          {cv.areas.map((area) => (
            <div>
              <dt>{t(area.name, lang)}</dt>
              <dd>{t(area.items, lang)}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="row" aria-labelledby="technical">
        <h2 id="technical">{s.technical}</h2>
        <p>{cv.technical.join(', ')}.</p>
      </section>

      <section class="row" aria-labelledby="education">
        <h2 id="education">{s.education}</h2>
        <div class="stack">
          {cv.education.map((item) => (
            <article>
              {item.start && (
                <p class="period">
                  {item.start}–{item.end}
                </p>
              )}
              <h3>{t(item.degree, lang)}</h3>
              {item.school && <p class="meta">{item.school}</p>}
            </article>
          ))}
        </div>
      </section>

      {cv.certifications.length > 0 && (
        <section class="row" aria-labelledby="certifications">
          <h2 id="certifications">{s.certifications}</h2>
          <ul class="bullets">
            {cv.certifications.map((item) => (
              <li>
                {item.name}, {item.issuer}, {item.year}
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="row" aria-labelledby="languages">
        <h2 id="languages">{s.languages}</h2>
        <p>
          {cv.languages
            .map((item) => `${t(item.name, lang)} (${t(item.level, lang).toLowerCase()})`)
            .join(', ')}
        </p>
      </section>
    </main>

    <footer class="row footer">
      <p>{cv.name}</p>
      <p>
        {s.updated} {updated}
      </p>
    </footer>
  </div>
</Layout>

<script>
  const root = document.documentElement;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .page {
    max-width: calc(var(--margin-col) + var(--measure) + 3rem);
    margin: 0 auto;
    padding: 1.25rem var(--gutter) 3rem;
  }

  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 1;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .theme {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .theme :global(.when-dark) {
    display: none;
  }

  :global([data-theme='dark']) .theme :global(.when-dark) {
    display: block;
  }

  :global([data-theme='dark']) .theme :global(.when-light) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme :global(.when-dark) {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .theme :global(.when-light) {
      display: none;
    }
  }

  /* Masthead */
  .masthead {
    display: grid;
    gap: 0.25rem;
    padding: clamp(2.5rem, 8vw, 5rem) 0 clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    font-size: clamp(2.75rem, 9vw, 5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .headline {
    margin-top: 1rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .profession {
    color: var(--muted);
    font-size: 1.125rem;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .contacts li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .contacts :global(.icon) {
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin: 2rem 0 3.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.375rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--ink));
  }

  .secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }

  /* Body rows: section name in the margin column, content in the measure. */
  .row {
    display: grid;
    gap: 0.75rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: var(--margin-col) minmax(0, var(--measure));
      column-gap: 3rem;
    }

    .row > :not(h2) {
      grid-column: 2;
    }
  }

  h2 {
    color: var(--accent);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
  }

  h3 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .lead {
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  .stack {
    display: grid;
    gap: 2rem;
  }

  .role {
    display: grid;
    gap: 0.5rem;
  }

  .period,
  .meta {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .bullets {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.1rem;
  }

  .bullets li::marker {
    color: var(--accent);
  }

  /* Functional areas set like green-bar ledger paper: alternate rows banded. */
  .ledger {
    margin: 0;
  }

  .ledger div {
    display: grid;
    gap: 0.125rem;
    padding: 0.75rem 0.875rem;
  }

  .ledger div:nth-child(odd) {
    background: var(--band);
  }

  @media (min-width: 36rem) {
    .ledger div {
      grid-template-columns: 8.5rem 1fr;
      gap: 1rem;
    }
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
  }

  .footer {
    border-bottom: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (min-width: 48rem) {
    .footer > p:first-child {
      grid-column: 1;
    }
  }

  @media print {
    .toolbar,
    .actions,
    .skip {
      display: none;
    }

    .page {
      max-width: none;
      padding: 0;
    }

    .masthead {
      padding-top: 0;
    }

    .row {
      break-inside: avoid;
    }
  }
</style>
