---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import CommandPalette, { type CommandGroup } from './CommandPalette.astro';
import { cv, formatPeriod, t, type Lang } from '../data/cv';
import { cvFiles, photo, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = ui[lang];
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const otherHref = otherLang === 'en' ? '/' : '/es/';
const files = cvFiles[lang];
const linkedin = cv.links.find((link) => link.label === 'LinkedIn');
const github = cv.links.find((link) => link.label === 'GitHub');

const sections = [
  { id: 'about', label: s.about },
  { id: 'experience', label: s.experience },
  ...(cv.projects.length ? [{ id: 'projects', label: s.projects }] : []),
  { id: 'skills', label: s.skills },
  { id: 'education', label: s.education },
];

const paletteGroups: CommandGroup[] = [
  {
    label: s.groupActions,
    items: [
      {
        label: s.downloadPdf,
        keywords: 'cv resume pdf download descargar',
        href: files.pdf,
        download: true,
      },
      { label: s.downloadDocx, keywords: 'cv resume word docx', href: files.docx, download: true },
      { label: s.themeToggle, keywords: 'theme tema dark light oscuro claro', action: 'theme' },
      { label: s.switchLang, keywords: 'language idioma english español', href: otherHref },
    ],
  },
  {
    label: s.groupGoTo,
    items: sections.map((section) => ({ label: section.label, href: `#${section.id}` })),
  },
  {
    label: s.groupLinks,
    items: cv.links.map((link) => ({ label: link.label, href: link.href, external: true })),
  },
];

const updated = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'es-SV', {
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<Layout lang={lang}>
  <a class="skip" href="#main">
    {s.skip}
  </a>

  <div class="page">
    <header class="masthead">
      <div class="intro">
        <h1>{cv.name}</h1>
        <p class="headline">
          {t(cv.headline, lang)}. {t(cv.tagline, lang)}
        </p>
        <p class="location">
          <Icon name="pin" />
          {t(cv.location, lang)}
        </p>
        <div class="actions">
          {linkedin && (
            <a
              class="square"
              href={linkedin.href}
              aria-label="LinkedIn"
              rel="me noopener"
              target="_blank"
            >
              <Icon name="linkedin" />
            </a>
          )}
          {github && (
            <a
              class="square"
              href={github.href}
              aria-label="GitHub"
              rel="me noopener"
              target="_blank"
            >
              <Icon name="github" />
            </a>
          )}
          <a class="primary" href={files.pdf} download>
            <Icon name="download" />
            {s.downloadPdf}
          </a>
          <button type="button" class="square" data-theme-toggle aria-label={s.themeToggle}>
            <Icon name="moon" class="when-dark" />
            <Icon name="sun" class="when-light" />
          </button>
          <a
            class="square lang"
            href={otherHref}
            hreflang={otherLang}
            lang={otherLang}
            aria-label={s.switchLang}
          >
            {s.switchLangShort}
          </a>
        </div>
      </div>
      <picture>
        <source srcset={photo.src} type="image/webp" />
        <img class="photo" src={photo.fallback} alt={cv.name} width="132" height="132" />
      </picture>
    </header>

    <main id="main">
      <section id="about" aria-labelledby="about-title">
        <h2 id="about-title">{s.about}</h2>
        <p class="body">{t(cv.summary, lang)}</p>
      </section>

      <section id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">{s.experience}</h2>
        {cv.experience.map((role) => (
          <article class="entry">
            <div class="entry-head">
              <h3>{role.company}</h3>
              <span class="date">{formatPeriod(role.start, role.end, lang)}</span>
            </div>
            <p class="role">{t(role.title, lang)}</p>
            <ul class="bullets">
              {role.highlights.map((item) => (
                <li>{t(item, lang)}</li>
              ))}
            </ul>
            {role.tags.length > 0 && (
              <ul class="chips small" aria-label={s.skills}>
                {role.tags.map((tag) => (
                  <li>{t(tag, lang)}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </section>

      {cv.projects.length > 0 && (
        <section id="projects" aria-labelledby="projects-title">
          <h2 id="projects-title">{s.projects}</h2>
          <div class="cards">
            {cv.projects.map((project) => (
              <article class="card">
                <h3>
                  {project.href ? (
                    <a href={project.href} target="_blank" rel="noopener">
                      {project.name}
                    </a>
                  ) : (
                    project.name
                  )}
                  <span class="live" aria-hidden="true" />
                </h3>
                <p>{t(project.description, lang)}</p>
                <ul class="chips tiny">
                  {project.tags.map((tag) => (
                    <li>{t(tag, lang)}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>
      )}

      <section id="skills" aria-labelledby="skills-title">
        <h2 id="skills-title">{s.skills}</h2>
        <div class="skill-group">
          <h3 class="label">{s.technical}</h3>
          <ul class="chips">
            {cv.technical.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </div>
        <div class="skill-group">
          <h3 class="label">{s.functional}</h3>
          <ul class="chips">
            {cv.areas.map((area) => (
              <li title={t(area.items, lang)}>{t(area.name, lang)}</li>
            ))}
          </ul>
        </div>
      </section>

      <section id="education" aria-labelledby="education-title">
        <h2 id="education-title">{s.education}</h2>
        {cv.education.map((item) => (
          <article class="entry">
            <div class="entry-head">
              <h3>{item.school}</h3>
              {item.start && (
                <span class="date">
                  {item.start} — {item.end}
                </span>
              )}
            </div>
            <p class="muted-body">{t(item.degree, lang)}</p>
          </article>
        ))}
      </section>

      {cv.certifications.length > 0 && (
        <section aria-labelledby="certifications-title">
          <h2 id="certifications-title">{s.certifications}</h2>
          {cv.certifications.map((item) => (
            <div class="entry-head">
              <h3>{item.name}</h3>
              <span class="date">{item.year}</span>
            </div>
          ))}
        </section>
      )}

      <section aria-labelledby="languages-title">
        <h2 id="languages-title">{s.languages}</h2>
        <ul class="languages">
          {cv.languages.map((item) => (
            <li>
              {t(item.name, lang)} <span>{t(item.level, lang).toLowerCase()}</span>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="footer">
      <span>
        {cv.name}, {t(cv.location, lang)}
      </span>
      <span>
        {s.updated} {updated}
      </span>
    </footer>
  </div>

  <div class="hint">
    <button type="button" data-palette-open>
      {s.palettePress} <kbd>Ctrl</kbd> + <kbd>K</kbd>{' '}
      {s.paletteHint}
    </button>
  </div>

  <CommandPalette
    groups={paletteGroups}
    strings={{
      label: s.paletteLabel,
      search: s.paletteSearch,
      empty: s.paletteEmpty,
      close: s.paletteClose,
    }}
  />
</Layout>

<script>
  const root = document.documentElement;
  const current = () => root.dataset.theme ?? 'dark';

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });

  // Show ⌘ instead of Ctrl on Apple devices.
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('.hint kbd:first-of-type').forEach((kbd) => (kbd.textContent = '⌘'));
  }
</script>

<style>
  .page {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: clamp(3rem, 9vw, 4.5rem) var(--gutter) 7rem;
  }

  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 2;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--bg);
  }

  /* Masthead */
  .masthead {
    display: flex;
    flex-wrap: wrap-reverse;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .intro {
    flex: 1 1 22rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .headline {
    max-width: 46ch;
    color: var(--ink-2);
    font-size: 1.125rem;
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .square,
  .primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.625rem;
    text-decoration: none;
    cursor: pointer;
  }

  .square {
    border: 1px solid var(--line);
    background: transparent;
  }

  .square:hover {
    background: var(--soft);
  }

  .lang {
    padding: 0 0.75rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .primary {
    gap: 0.5rem;
    padding: 0 1rem;
    background: var(--ink);
    color: var(--bg);
    font-weight: 500;
  }

  .primary:hover {
    opacity: 0.88;
  }

  /* Only the icon for the current theme is shown. */
  .square :global(.when-light) {
    display: none;
  }

  :global([data-theme='light']) .square :global(.when-light) {
    display: block;
  }

  :global([data-theme='light']) .square :global(.when-dark) {
    display: none;
  }

  .photo {
    flex: 0 0 auto;
    display: block;
    width: 8.25rem;
    height: 8.25rem;
    border-radius: 1.375rem;
    object-fit: cover;
    background: var(--soft);
  }

  /* Sections */
  main {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  main section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    scroll-margin-top: 2rem;
  }

  h2 {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .body,
  .muted-body,
  .bullets {
    color: var(--ink-2);
  }

  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .date {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .role {
    font-weight: 500;
  }

  .bullets {
    display: grid;
    gap: 0.25rem;
    padding-left: 1.1rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .chips li {
    padding: 0.25rem 0.625rem;
    border-radius: 0.5rem;
    background: var(--soft);
  }

  .chips.small {
    gap: 0.375rem;
    margin-top: 0.25rem;
    font-size: 0.75rem;
  }

  .chips.small li,
  .chips.tiny li {
    padding: 0.125rem 0.5rem;
    border-radius: 0.375rem;
  }

  .chips.tiny {
    gap: 0.375rem;
    margin-top: auto;
    font-size: 0.6875rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.125rem;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
  }

  .card p {
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  .live {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--live);
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .label {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding: 0;
    list-style: none;
  }

  .languages span {
    color: var(--muted);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  /* Sticky command palette hint, as on the reference site. */
  .hint {
    position: fixed;
    inset: auto 0 0;
    display: flex;
    justify-content: center;
    padding: 0.5rem var(--gutter);
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .hint button {
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 0.875rem;
    cursor: pointer;
  }

  @media (hover: none) {
    .hint {
      display: none;
    }
  }

  @media print {
    .actions,
    .hint,
    .skip {
      display: none;
    }

    .page {
      padding: 0;
    }

    main section {
      break-inside: avoid;
    }
  }
</style>
